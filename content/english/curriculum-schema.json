    "CefrSkeletonDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "documentType",
        "courseId",
        "preA1FoundationAlignment",
        "officialCefrDisclaimerUz",
        "officialCefrDisclaimerRu",
        "levels"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "documentType": { "type": "string", "const": "cefr_skeleton" },
        "courseId": { "type": "string", "const": "course_eng_01" },
        "preA1FoundationAlignment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cefrLevel", "titleUz", "titleRu", "noteUz", "noteRu", "foundationLessonIds"],
          "properties": {
            "cefrLevel": { "type": "string", "const": "Pre-A1" },
            "titleUz": { "type": "string", "minLength": 3 },
            "titleRu": { "type": "string", "minLength": 3 },
            "noteUz": { "type": "string", "minLength": 10 },
            "noteRu": { "type": "string", "minLength": 10 },
            "foundationLessonIds": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string" }
            }
          }
        },
        "officialCefrDisclaimerUz": { "type": "string", "minLength": 10 },
        "officialCefrDisclaimerRu": { "type": "string", "minLength": 10 },
        "levels": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/SkeletonLevel" }
        }
      }
    },
    "LevelCurriculumDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "documentType",
        "courseId",
        "cefrLevel",
        "starterLessonId",
        "foundationLessonIds",
        "skills",
        "lessonsOrder",
        "officialCefrDisclaimerUz",
        "officialCefrDisclaimerRu",
        "modules",
        "lessons",
        "roadmapNodes"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "documentType": { "type": "string", "const": "level_curriculum" },
        "courseId": { "type": "string", "const": "course_eng_01" },
        "cefrLevel": { "$ref": "#/$defs/CefrLevelId" },
        "starterLessonId": { "type": "string", "const": "lesson_eng_starter" },
        "foundationLessonIds": {
          "type": "array",
          "const": ["lesson_eng_starter", "lesson_eng_foundation_02"]
        },
        "skills": {
          "type": "array",
          "const": [
            "skill_eng_vocab",
            "skill_eng_grammar",
            "skill_eng_listening",
            "skill_eng_reading"
          ]
        },
        "lessonsOrder": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^lesson_eng_[a-z0-9_]+$" }
        },
        "officialCefrDisclaimerUz": { "type": "string", "minLength": 10 },
        "officialCefrDisclaimerRu": { "type": "string", "minLength": 10 },
        "legacyMigrationNotes": {
          "type": "object",
          "additionalProperties": true
        },
        "modules": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/SkeletonModule" }
        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Lesson" }
        },
        "roadmapNodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/LearningPathNode" }
        }
      }
    },
    "PlacementQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "courseId",
        "skillId",
        "skillDomain",
        "difficulty",
        "cefrLevel",
        "topic",
        "questionType",
        "isPlacement",
        "text",
        "textRu",
        "options",
        "correctIndex",
        "explanation",
        "explanationRu",
        "wrongFeedback",
        "wrongFeedbackRu",
        "mistakeFeedbackByOption"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^q_eng_place_[a-z0-9_]+$" },
        "courseId": { "type": "string", "const": "course_eng_01" },
        "skillId": { "$ref": "#/$defs/SkillId" },
        "skillDomain": { "type": "string", "enum": ["vocabulary", "grammar", "listening", "reading"] },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "cefrLevel": { "type": "string", "enum": ["A1", "A2", "B1"] },
        "topic": { "type": "string", "minLength": 2 },
        "questionType": { "type": "string", "const": "multiple_choice" },
        "isPlacement": { "type": "boolean", "const": true },
        "text": { "type": "string", "minLength": 5 },
        "textRu": { "type": "string", "minLength": 5 },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "correctIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
        "explanation": { "type": "string", "minLength": 10 },
        "explanationRu": { "type": "string", "minLength": 10 },
        "wrongFeedback": { "type": "string", "minLength": 10 },
        "wrongFeedbackRu": { "type": "string", "minLength": 10 },
        "mistakeFeedbackByOption": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": { "$ref": "#/$defs/LocalizedPair" }
        },
        "media": { "$ref": "#/$defs/LessonMedia" }
      },
      "allOf": [
        {
          "if": { "properties": { "skillId": { "const": "skill_eng_listening" } } },
          "then": { "required": ["media"] }
        }
      ]
    },
    "PlacementDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "documentType",
        "courseId",
        "cefrRange",
        "questions"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "documentType": { "type": "string", "const": "placement_bank" },
        "courseId": { "type": "string", "const": "course_eng_01" },
        "cefrRange": {
          "type": "array",
          "const": ["A1", "A2", "B1"]
        },
        "questions": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/PlacementQuestion" }
        }
      }
    }
  }
